# O better-sqlite3 já traz o binário pronto (pasta prebuilds/). Instalando pelo
# package-lock, o npm 11 ignora o "gypfile": false dele e tenta compilar com
# node-gyp, o que exige Visual Studio com C++ no Windows. Nenhuma dependência
# deste projeto precisa de script de instalação; "npm run ..." continua funcionando.
ignore-scripts=true
